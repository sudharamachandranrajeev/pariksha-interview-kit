# Libraries do not commit a lock file; the example app does.
/packages/*/pubspec.lock

# Local checkouts for development (see README). Never commit these.
pubspec_overrides.yaml

# Symbolication and obfuscation
app.*.symbols
app.*.map.json

# Secrets: never commit signing keys or env files
*.jks
*.keystore
key.properties
.env
.env.*

# Interview recordings and downloaded models never belong in the repo
*.wav
*.onnx
*.tflite
recordings/
models/
